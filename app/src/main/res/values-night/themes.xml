<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 深色系统：深色基座 → WebView prefers-color-scheme=dark → 页面深色主题 -->
    <style name="Theme.ZCodeMobile" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:windowSplashScreenBackground">@color/window_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_background</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
